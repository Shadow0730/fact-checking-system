# ─────────────────────────── Sarvam ───────────────────────────
# Your Sarvam API subscription key. Sent as the `api-subscription-key` header.
SARVAM_API_KEY=

# Base URL for all Sarvam calls.
SARVAM_BASE_URL=https://api.sarvam.ai

# LLM used to extract claims (and for the baseline comparison).
SARVAM_LLM_MODEL=sarvam-105b
# Path of the OpenAI-compatible chat endpoint, appended to SARVAM_BASE_URL.
SARVAM_LLM_PATH=/v2/chat/completions
# "none" keeps the model from spending its whole token budget "thinking".
SARVAM_LLM_REASONING_EFFORT=none
# Always send max_tokens; the server default is too short for long claim lists.
SARVAM_LLM_MAX_TOKENS=6000
SARVAM_LLM_TEMPERATURE=0.1

# Prism, the decision model. Endpoint path appended to SARVAM_BASE_URL.
SARVAM_PRISM_MODEL=sarvam-prism
SARVAM_PRISM_PATH=/v2/systemone

# Network timeout for any Sarvam call, in seconds.
SARVAM_TIMEOUT_S=60
# Maximum Sarvam requests in flight at once (protects you from 429 rate limits).
SARVAM_MAX_CONCURRENCY=4

# Run without any API key: claim extraction uses regex only and judging uses
# keyword overlap. For UI development only; results are NOT meaningful.
OFFLINE_MODE=false

# ─────────────────────────── Indian Kanoon (optional) ───────────────────────────
# Citations that are not in the local corpus are looked up on Indian Kanoon, verified against the
# fetched document, and saved into corpus/files/indiankanoon/ (so each one is paid for only once).
# Empty = off: only the local corpus is used. Get a token at https://api.indiankanoon.org
INDIANKANOON_API_TOKEN=
INDIANKANOON_BASE_URL=https://api.indiankanoon.org
INDIANKANOON_TIMEOUT_S=30
# At most this many distinct citations are looked up per check (cost cap; ~Rs 0.5 per search,
# ~Rs 0.2 per document at the time of writing; check their pricing page).
INDIANKANOON_MAX_LOOKUPS=8

# ─────────────────────────── Storage ───────────────────────────
# Leave DATABASE_URL empty (the default) to run with no database at all: the corpus in
# corpus/manifest.yaml is loaded into memory at startup and each check is saved as a JSON
# file under DATA_DIR/checks/. Embeddings are cached under DATA_DIR/cache/.
#
# Optional: point it at your own PostgreSQL 16 with the pgvector extension (apply db/init.sql
# with `python scripts/init_db.py`, then `python scripts/ingest_corpus.py`).
#   DATABASE_URL=postgresql+psycopg://factcheck:change-me-please@localhost:5432/factcheck
DATABASE_URL=
# Relative to backend/ or absolute.
DATA_DIR=../data

# ─────────────────────────── Embeddings ───────────────────────────
# Any sentence-transformers model. bge-m3 is multilingual, 1024-dim.
# Set to "hash" for a tiny dependency-free embedder (UI development / tests only).
EMBEDDING_MODEL=BAAI/bge-m3
# MUST match the model's output size (and the vector(N) column in db/init.sql if you use Postgres).
EMBEDDING_DIM=1024
# cpu | cuda | mps
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# Optional, only if Hugging Face rate-limits the download.
HF_TOKEN=

# ─────────────────────────── Corpus and ingestion ───────────────────────────
# Folder holding manifest.yaml and the source files (relative to backend/ or absolute).
CORPUS_DIR=../corpus
CHUNK_TARGET_CHARS=1800
CHUNK_MAX_CHARS=3000

# ─────────────────────────── Retrieval ───────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RRF_K=60

# ─────────────────────────── Verdict thresholds ───────────────────────────
# Tune these on eval/gold/dev.jsonl. Prism's RAW probability is compared.
THRESH_SUPPORTED=0.90
THRESH_WEAK=0.60
THRESH_CONTRADICTED=0.50
# rapidfuzz scores, 0-100.
QUOTE_EXACT=97
QUOTE_NEAR=85

# ─────────────────────────── App ───────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
MAX_DRAFT_CHARS=60000
MAX_UPLOAD_MB=20

# ─────────────────────────── Frontend ───────────────────────────
# Read by Next.js at build time. Put it in frontend/.env.local too.
NEXT_PUBLIC_API_URL=http://localhost:8000
